# BookedOut environment variables.
# Copy this file to .env.local and fill in the values from your own Supabase project
# (Project Settings -> API) or from `npx supabase start` output for local development.
# .env.local is git-ignored. Never commit real keys.

# --- Public (browser-safe) -------------------------------------------------
# The "anon" / publishable key is designed to be shipped to browsers; Row Level
# Security is what protects your data. Still, it is tied to your project, so it
# lives in .env.local and not in source control.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server-only -----------------------------------------------------------
# Service role key bypasses Row Level Security. Only needed for trusted admin
# tooling and never sent to the browser. Leave empty for normal app usage.
SUPABASE_SERVICE_ROLE_KEY=

# --- Payments --------------------------------------------------------------
# Only "test" is implemented. Test mode records a local trial, requests no card
# and charges nothing. A real provider must be added in server-only code first.
PAYMENTS_PROVIDER=test

# --- Local security tests --------------------------------------------------
# Only used by `npm run test:rls`, which runs migrations in an in-process
# Postgres (PGlite). No value is needed for that; leave these unset unless you
# point the tests at a real database.
